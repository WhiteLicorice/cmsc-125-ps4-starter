* text=auto

# The shell scripts run under sh on every platform, so they stay LF.
run text eol=lf
check.sh text eol=lf

# The checker compares every output line and every diagnostic byte for byte.
# A CRLF checkout on Windows would make every expectation disagree with a
# program that writes LF. The sources and build files stay LF too.
*.c text eol=lf
*.h text eol=lf
Makefile text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.case text eol=lf
*.out text eol=lf
*.err text eol=lf
*.status text eol=lf
*.txt text eol=lf

# GitHub reports the repository's language from the byte count of each source
# language. The checker and the shell entry points are not C, so hide them from
# that count and leave the C sources and the header detectable.
*.py linguist-detectable=false
*.sh linguist-detectable=false
/run linguist-detectable=false
